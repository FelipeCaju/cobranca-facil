# Copie para .env na raiz do servidor. Nao use senhas reais neste arquivo de exemplo.

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sua_base
DB_USERNAME=seu_usuario
# Senha com # ou espacos: use aspas
DB_PASSWORD="sua_senha_aqui"

JWT_SECRET=gere_um_segredo_longo_aleatorio_minimo_32_caracteres
# O portal público usa JWT_SECRET para assinar links temporários.

# URL publica sem barra no final.
APP_URL=https://seudominio.com.br

# Caminho do frontend:
# - Dominio raiz/subdominio: /
# - Subpasta Laragon: /cobx/
VITE_BASE_PATH=/
